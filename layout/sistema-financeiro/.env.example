# Copie para backend/.env e ajuste. NUNCA coloque chaves reais neste arquivo.
LLM_PROVIDER=mock            # mock | anthropic | openai
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PRICE_PER_MTOK_INPUT=
PRICE_PER_MTOK_OUTPUT=
MAX_COST_PER_DAY=1.00

TICKERS=PETR4.SA,VALE3.SA,ITUB4.SA
BENCHMARK=^BVSP
CYCLE_INTERVAL_MIN=60
NEWS_FEEDS=                  # URLs RSS separadas por vírgula

INITIAL_CASH=100000
FEE_PCT=0.0003
SLIPPAGE_PCT=0.0005
MAX_RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.20
MAX_DAILY_LOSS=0.03
ATR_STOP_MULT=2
CANDIDATE_MAX_DRAWDOWN=0.20  # backtest: drawdown máximo para "candidato"
CANDIDATE_MIN_TRADES=20      # backtest: mínimo de operações fechadas

LIVE_TRADING_ENABLED=false   # NÃO alterar. Não há broker real implementado.
DATABASE_URL=sqlite:///./trading_room.db

CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1   # hosts aceitos pelo backend (proteção contra DNS rebinding)
OFFICE_CONFIG=                      # vazio = backend/office.yaml (salas e robôs)
