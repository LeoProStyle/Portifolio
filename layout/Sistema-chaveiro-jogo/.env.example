# RetroKey environment variables — NAMES ONLY.
# Copy to .env.local and fill in real values. Never commit real values.
# In production, set these in the Vercel project settings.

# MongoDB
MONGODB_URI=
MONGODB_DB=

# Auth (NextAuth v5). Generate with: npx auth secret
AUTH_SECRET=

# Admin login
# Production requires ADMIN_USERNAME, ADMIN_PASSWORD_HASH and AUTH_SECRET; without all three every login is refused.
ADMIN_USERNAME=
# Generate with: npm run hash-password (the password is read from the keyboard, never from the command line)
ADMIN_PASSWORD_HASH=
# Development only, ignored in production. When ADMIN_PASSWORD_HASH is set, the hash wins.
ADMIN_PASSWORD=

# Cloudflare R2 (ROM files and rooms.json)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ROOMS_KEY=
