# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
# Nunca envie o .env.local para o Git.

# MongoDB Atlas — string de conexão do cluster
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Banco exclusivo da loja (é criado sozinho na primeira gravação / npm run db:init)
MONGODB_DB=Lanchonete-QgOcian

# Login do Admin e do Dashboard
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Login do sistema (funcionário) — acessa Saída e Vendas
SIST_USERNAME=
SIST_PASSWORD=

# Chave para assinar o cookie de sessão — use um texto longo e aleatório (32+ caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
